# 复制为 .env 后再启动 Docker Compose。不要把真实密钥提交到版本库。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password
# 至少 32 字节的随机字符串，例如使用密码管理器生成 64 位随机值。
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
# 浏览器可访问的附件下载前缀；使用域名部署时改成实际后端地址。
FILE_BASE_URL=http://localhost:8080/api/v1/files
# 本地 Compose 默认使用 dev。正式环境必须设置为 prod。
SPRING_PROFILES_ACTIVE=dev
